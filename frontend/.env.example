# Copy to .env before running `npm run dev` / `npm run build`.

# Backend API base URL (used by the Hero signup form)
VITE_API_BASE_URL=http://localhost:8000

# Real Stripe Payment Link / Checkout Session URL for the $29/mo Pro plan.
# The placeholder below does NOT process payment.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/REPLACE_WITH_YOUR_LINK
