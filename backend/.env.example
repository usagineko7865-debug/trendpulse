# Copy this file to .env and fill in real values (or export as real env vars
# in your hosting platform). Nothing in this app will silently invent data —
# missing keys cause the relevant feature to fail loudly or no-op, not fake.

# --- AI content generation (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-8

# --- Trend data source (YouTube Data API v3 — real data, not simulated) ---
# Get a free key: https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" on the project first)
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TREND_REGION_CODES=US,GB,JP,ES
TREND_CATEGORY_ID=28
TREND_MAX_RESULTS=8

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email delivery (Gmail SMTP) ---
# Generate an App Password (needs 2-Step Verification enabled first):
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=TrendPulse

# --- App ---
LP_BASE_URL=https://your-domain.example.com
DB_PATH=trendpulse.db
INTERNAL_TRIGGER_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=https://your-domain.example.com
